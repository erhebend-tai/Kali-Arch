{
  "title": "CleanArch Platform — Overview",
  "uid": "cleanarch-overview",
  "schemaVersion": 39,
  "tags": ["platform", "cleanarch"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(platform_requests_total[5m])",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "100 * rate(platform_errors_total[5m]) / rate(platform_requests_total[5m])",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(platform_request_duration_ms_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(platform_request_duration_ms_bucket[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(platform_request_duration_ms_bucket[5m]))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 4,
      "title": "Memory working set",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "memory_working_set_bytes", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 5,
      "title": "Outbox backlog",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "targets": [
        { "expr": "outbox_unprocessed_messages" }
      ]
    },
    {
      "id": 6,
      "title": "VMs by status",
      "type": "piechart",
      "gridPos": { "h": 6, "w": 8, "x": 6, "y": 16 },
      "targets": [
        { "expr": "vm_status_total", "legendFormat": "{{status}}" }
      ]
    }
  ]
}
