<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="DbUp" />
    <PackageReference Include="dbup-postgresql" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versioned SQL scripts — DbUp applies these at startup. -->
    <EmbeddedResource Include="Persistence\Scripts\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VirtualMachineService.Application\VirtualMachineService.Application.csproj" />
    <ProjectReference Include="..\VirtualMachineService.Domain\VirtualMachineService.Domain.csproj" />
    <ProjectReference Include="..\..\..\..\shared\CleanArch.Shared.Contracts\CleanArch.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\shared\CleanArch.Shared.Grpc\CleanArch.Shared.Grpc.csproj" />
    <ProjectReference Include="..\..\..\..\shared\CleanArch.Shared.Infrastructure\CleanArch.Shared.Infrastructure.csproj" />
  </ItemGroup>

</Project>
