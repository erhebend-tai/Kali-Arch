<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Feed layout:
      nuget.org        — public packages
      GitHub Packages  — yourorg's published packages (analyzer,
                         contracts, shared libs)
      Azure Artifacts  — internal feed alternative; keep the one
                         you use, delete the other.
    Credentials come from environment variables — never commit
    real values here.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org"
         value="https://api.nuget.org/v3/index.json" />
    <add key="github"
         value="https://nuget.pkg.github.com/yourorg/index.json" />
    <add key="azure-artifacts"
         value="https://pkgs.dev.azure.com/yourorg/_packaging/yourfeed/nuget/v3/index.json" />
  </packageSources>

  <packageSourceCredentials>
    <github>
      <add key="Username" value="%GITHUB_ACTOR%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github>
    <azure-artifacts>
      <add key="Username" value="%AZURE_ARTIFACTS_USER%" />
      <add key="ClearTextPassword" value="%AZURE_ARTIFACTS_TOKEN%" />
    </azure-artifacts>
  </packageSourceCredentials>

  <!--
    Source mapping — every package resolves from exactly one
    source, so a typosquatted private package on nuget.org
    can't win a restore.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="CleanArch.*" />
      <package pattern="YourPlatform.*" />
    </packageSource>
    <packageSource key="azure-artifacts">
      <package pattern="CleanArch.*" />
      <package pattern="YourPlatform.*" />
    </packageSource>
  </packageSourceMapping>

  <packageRestore>
    <add key="enabled" value="true" />
    <add key="automatic" value="true" />
  </packageRestore>

</configuration>
